# OllyAI - example environment file.
# Copy to .env and fill in. NEVER commit your real .env.
# You can also just paste any key into OllyAI with:  /key <paste>
# and it will auto-detect the provider.

# --- The "brain" (default) ---
GEMINI_API_KEY=

# --- Free / open-source model providers ---
NVIDIA_API_KEY=          # https://build.nvidia.com  (nvapi-...)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (sk-or-v1-...)
GROQ_API_KEY=            # https://console.groq.com/keys (gsk_...)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai (csk-...)
MISTRAL_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=                # https://huggingface.co/settings/tokens (hf_...)
GITHUB_MODELS_TOKEN=     # a GitHub PAT also unlocks GitHub Models

# --- Git hosting (so OllyAI can push / open PRs on your repos) ---
GITHUB_TOKEN=            # ghp_... or github_pat_...

# --- Local models (no key needed) ---
OLLAMA_HOST=http://127.0.0.1:11434
